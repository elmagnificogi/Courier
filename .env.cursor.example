# ============================================================================
# Cursor Instance - Copy this to .env.cursor (or .env if running single IDE)
# ============================================================================
# Launch Cursor with: Cursor.exe --remote-debugging-port=9222
# Or use: launch-cursor-debug.bat (in project root)
#
# Run with: DOTENV_CONFIG_PATH=.env.cursor npx tsx src/index.ts
# ============================================================================

NODE_ENV=development
LOG_LEVEL=info
PORT=8787

# --- IDE Target ---
BRIDGE_IDE_TARGET=cursor
BRIDGE_BACKEND_MODE=cdp
BRIDGE_API_AUTH_TOKEN=

# --- Telegram Bot ---
# Create via @BotFather: https://t.me/BotFather → /newbot → name it "Cursor Bridge" or similar
# IMPORTANT: Use a dedicated bot token per IDE instance.
TELEGRAM_BOT_TOKEN=
# Find your ID: message @userinfobot on Telegram
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_REQUEST_TIMEOUT_MS=30000

# --- Cursor CDP ---
CURSOR_REMOTE_DEBUG_URL=http://127.0.0.1:9222
CURSOR_APP_EXE=Cursor
CURSOR_TARGET_TITLE_HINT=Cursor
CURSOR_CHAT_INPUT_SELECTOR=
CURSOR_RESPONSE_SELECTOR=
CURSOR_CONTEXT_SELECTOR=
CURSOR_MODEL_SELECTOR=
CURSOR_CONTEXT_REGION=
CURSOR_CONTEXT_HOVER_POINT=
CURSOR_ACTION_TIMEOUT_MS=30000
# How long to wait for a full Cursor agent turn (progress + final reply). Default 1 hour.
CURSOR_RELAY_MAX_MS=3600000
# Leave blank for auto-detect, or set to your local state.vscdb path.(\AppData\Roaming\cursor\User\globalStorage\state.vscdb)
CURSOR_SQLITE_PATH=

# --- Cursor API (optional, only if BRIDGE_BACKEND_MODE=api) ---
CURSOR_API_KEY=
CURSOR_API_BASE_URL=https://api.cursor.com
CURSOR_API_REPOSITORY=
CURSOR_API_MODEL=
CURSOR_API_REF=
CURSOR_API_TIMEOUT_MS=30000

# --- Discord (optional) ---
# Create bot: https://discord.com/developers/applications → New App → Bot → Copy token
# IMPORTANT: Use a dedicated bot token per IDE instance.
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_IDS=

# --- Email (optional) ---
EMAIL_ENABLED=false
EMAIL_ALLOWED_FROM=
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_SECURE=true
EMAIL_IMAP_USER=
EMAIL_IMAP_PASS=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_POLL_INTERVAL_MS=30000

# --- Feishu (optional) ---
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_ALLOWED_OPEN_IDS=

# --- WeCom / 企业微信 (optional) ---
# 自建应用 → 接收消息 → 设置回调 URL:
#   http://<your-host>:8787/platform/wecom/callback
# 普通微信可通过企业微信「微信插件」给该应用发消息。
WECOM_ENABLED=false
WECOM_CORP_ID=
WECOM_AGENT_ID=0
WECOM_SECRET=
WECOM_TOKEN=
WECOM_AES_KEY=
WECOM_ALLOWED_USER_IDS=
WECOM_API_BASE=https://qyapi.weixin.qq.com

# --- WeCom intelligent robot / 企业微信智能机器人 (optional) ---
# 管理后台 → 智能机器人 → API 模式 → 长连接。不需要公网域名。
# 长连接与「设置接收消息 URL」互斥，同一机器人只能选一种。
WECOM_AIBOT_ENABLED=false
WECOM_AIBOT_BOT_ID=
WECOM_AIBOT_SECRET=
WECOM_AIBOT_WS_URL=wss://openws.work.weixin.qq.com
WECOM_AIBOT_ALLOWED_USER_IDS=

# --- WeChat Official Account / 微信公众号 (optional) ---
# 服务号/订阅号 → 基本配置 → 服务器 URL:
#   http://<your-host>:8787/platform/wechat/callback
# 长任务走客服消息接口，用户需在 48 小时内先给公众号发过消息。
WECHAT_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TOKEN=
WECHAT_AES_KEY=
WECHAT_ALLOWED_OPEN_IDS=
WECHAT_API_BASE=https://api.weixin.qq.com

# --- QQ Bot / QQ 官方机器人 (optional) ---
# 开放平台 https://q.qq.com → Webhook:
#   https://<public-host>/platform/qq/events
# QQ 仅允许回调端口 80/443/8080/8443，本地 8787 需反代。
QQ_ENABLED=false
QQ_APP_ID=
QQ_APP_SECRET=
QQ_ALLOWED_OPEN_IDS=
QQ_ALLOWED_GROUP_OPEN_IDS=
QQ_API_BASE=https://api.bot.qq.com
QQ_EVENT_MODE=websocket

